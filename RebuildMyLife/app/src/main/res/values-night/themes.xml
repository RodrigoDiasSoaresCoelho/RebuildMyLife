<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RebuildMyLife" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>

        <!-- colorPrimaryDark is used for the status bar -->
        <item name="colorPrimaryDark">@color/primary_color</item>

        <!-- colorAccent is used as the default value for colorControlActivated,
             which is used to tint widgets -->
        <item name="colorAccent">@color/primary_color</item>

        <item name="card_color">@color/bottomBar</item>

        <item name="text_color">@color/gray</item>

        <item name="icon_color">@color/gray</item>

        <item name="icon_add_color">@color/white</item>

        <item name="background_color">@color/background_night</item>
    </style>
</resources>